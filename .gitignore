__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
# Harvester OUTPUT dir for local attachment downloads — anchored to the repo root
# so it does NOT also match the SOURCE package autogis/core/harvest/. The old
# unanchored `harvest/` matched the package dir, which kept its __init__.py
# un-committable (so the package shipped without one) — the reason the harvester
# was absent from the codebase-memory index. See docs/codebase-memory-mcp.md 2026-06-30.
/harvest/
.superpowers/

# headroom runtime artifacts (defense-in-depth; relocated to $HOME by the hook)
.headroom/
headroom_memory.db
# headroom --learn writes personal learnings to CLAUDE.local.md (issue #1072).
# It is untracked, so without this line `?? CLAUDE.local.md` dirties the main
# tree and silently blocks SessionStart's clean-only ff-pull → main drift.
# Claude Code still loads CLAUDE.local.md as personal memory regardless of git.
CLAUDE.local.md
# Insurance: repo-root file only the non-Claude GenericMemoryWriter would emit
# (the Claude path writes ~/.claude/.../memory/MEMORY.md instead). Cheap guard.
HEADROOM_MEMORY.md

# transient agent memory state — never commit
.claude/agent-memory-local/

# Session coordination registry (local-only, never committed)
.claude/coordination/claims.json*

# Worktrees + stray local artifacts
.claude/worktrees/
test_output.txt

# CLI-seam run recorder output (ADR-0054) — runtime artifact, not source
run_history.csv

# Project MCP server config — local-only per CLAUDE.md ("There is no project
# .mcp.json"). Kept out of the repo so it never auto-loads for other sessions.
.mcp.json
